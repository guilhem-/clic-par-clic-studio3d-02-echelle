# Jeton partagé entre Open WebUI et le studio (secret Kubernetes « studio », clé « jeton »).
# Reprenez celui du module 1, ou générez-en un : openssl rand -hex 24
STUDIO_JETON=
# Mot de passe de Redis (secret Kubernetes « studio », clé « redis »). Générez-en un : openssl rand -hex 24
REDIS_MOT_DE_PASSE=
